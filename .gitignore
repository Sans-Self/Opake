# .claude/ — generated/machine-local (not project source)
.claude/hooks/
.claude/commands/
.claude/mcp/
# Tracked when manually configured: .claude/settings.json (project settings).
# .claude/settings.local.json is per-developer — ignored below.

# Claude Code
.claude/settings.local.json
.claude/hooks/node_modules/
.claude/worktrees
.claude/scheduled_tasks.lock
.playwright-mcp/

# nix / direnv
.direnv/
.envrc.local
/result
/result-*
.claude/skills/openspec-*

# Playwright storage-state snapshots hold live bearer credentials for the
# dev-stack test accounts (see SECURITY.md).
.auth/

# dev-env TLS material is generated locally by dev-env/certs/regen.sh —
# never committed, so a published CA key cannot be trusted by anyone.
dev-env/certs/*.key
dev-env/certs/*.crt
