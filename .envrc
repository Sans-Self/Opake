# Frontend URL for CLI OAuth callback redirect
# Production: https://opake.app/devices/cli-callback
export OPAKE_FRONTEND_URL=http://localhost:5173

# Indexer URL for CLI commands
# Production: https://indexer.opake.app
export OPAKE_INDEXER_URL=http://localhost:6100
export VITE_INDEXER_URL=$OPAKE_INDEXER_URL
