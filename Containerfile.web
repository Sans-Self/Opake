FROM oven/bun:1 AS web-deps

WORKDIR /build/apps/web
COPY apps/web/package.json apps/web/bun.lock ./
RUN bun install --frozen-lockfile

FROM zot.sans-self.org/infra/rust-wasm:latest AS wasm-builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/cli/ apps/cli/

RUN wasm-pack build crates/opake-wasm --target web --out-dir ../../apps/web/src/wasm/opake-wasm --out-name opake

FROM web-deps AS web-builder

ARG VITE_INDEXER_URL=https://indexer.opake.app
ARG VITE_SITE_URL=https://opake.app
ENV VITE_INDEXER_URL=$VITE_INDEXER_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

COPY apps/web/ ./
COPY --from=wasm-builder /build/apps/web/src/wasm/opake-wasm/ ./src/wasm/opake-wasm/

RUN bun run tsc && bun run vite build

FROM oven/bun:1-slim

RUN groupadd -g 1000 opake || true && useradd -u 1000 -g 1000 -m opake || true

WORKDIR /app
COPY --from=web-builder --chown=1000:1000 /build/apps/web/dist/ ./dist/
COPY --from=web-builder --chown=1000:1000 /build/apps/web/node_modules/ ./node_modules/
COPY --from=web-builder --chown=1000:1000 /build/apps/web/package.json ./
COPY --from=web-builder --chown=1000:1000 /build/apps/web/serve.ts ./

USER 1000:1000
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["bun", "run", "serve.ts"]
