# Workspace install: bun needs every workspace member's package.json to
# resolve @opake/* dependencies; sources come later so this layer only
# invalidates when a manifest changes.
FROM oven/bun:1 AS web-deps

WORKDIR /build
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY packages/opake-sdk/package.json packages/opake-sdk/
COPY packages/opake-daemon/package.json packages/opake-daemon/
COPY packages/opake-react/package.json packages/opake-react/
COPY tests/package.json tests/
RUN bun install --frozen-lockfile

# rust:1 tracks latest stable, matching the dev shell (flake.nix pins
# rust-bin.stable.latest) so the image compiles with the same toolchain
# development and CI test against.
FROM rust:1-slim-bookworm AS wasm-builder

# Prebuilt, pinned wasm-pack: a source build costs minutes per cold cache.
RUN apt-get update -y && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    curl -sSfL https://github.com/rustwasm/wasm-pack/releases/download/v0.13.1/wasm-pack-v0.13.1-x86_64-unknown-linux-musl.tar.gz \
    | tar xz --strip-components=1 -C /usr/local/bin wasm-pack-v0.13.1-x86_64-unknown-linux-musl/wasm-pack

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/cli/ apps/cli/
# opake-core includes the shared lexicon vocabulary relative to the
# workspace root at compile time.
COPY lexicons/ lexicons/

# Same invocation and output path as `just wasm`.
RUN wasm-pack build crates/opake-wasm --target web --out-dir ../../packages/opake-sdk/wasm --out-name opake

FROM web-deps AS web-builder

ARG VITE_INDEXER_URL=https://indexer.opake.at
ARG VITE_SITE_URL=https://opake.at
ENV VITE_INDEXER_URL=$VITE_INDEXER_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

COPY packages/ packages/
COPY apps/web/ apps/web/
COPY --from=wasm-builder /build/packages/opake-sdk/wasm/ packages/opake-sdk/wasm/

# Same chain as `just web-build`: sdk -> daemon -> react, then the app.
RUN cd packages/opake-sdk && bun run build && \
    cd ../opake-daemon && bun run build && \
    cd ../opake-react && bun run build

WORKDIR /build/apps/web
RUN bun run build

FROM oven/bun:1-slim

RUN groupadd -g 1000 opake || true && useradd -u 1000 -g 1000 -m opake || true

WORKDIR /app
COPY --from=web-builder --chown=1000:1000 /build/apps/web/dist/ ./dist/
COPY --from=web-builder --chown=1000:1000 /build/node_modules/ ./node_modules/
COPY --from=web-builder --chown=1000:1000 /build/apps/web/package.json ./
COPY --from=web-builder --chown=1000:1000 /build/apps/web/serve.ts ./

USER 1000:1000
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["bun", "run", "serve.ts"]
