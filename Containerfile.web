FROM oven/bun:1 AS web-deps

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

FROM rust:1.88-slim-bookworm AS wasm-builder

RUN cargo install wasm-pack --locked

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN wasm-pack build crates/opake-wasm --target web --out-dir ../../web/src/wasm/opake-wasm --out-name opake

FROM web-deps AS web-builder

ARG VITE_APPVIEW_URL=https://appview.opake.app
ARG VITE_SITE_URL=https://opake.app
ENV VITE_APPVIEW_URL=$VITE_APPVIEW_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

COPY web/ ./
COPY --from=wasm-builder /build/web/src/wasm/opake-wasm/ ./src/wasm/opake-wasm/

RUN bun run tsc && bun run vite build

FROM node:22-slim

RUN groupadd -g 1000 opake || true && useradd -u 1000 -g 1000 -m opake || true

WORKDIR /app
COPY --from=web-builder --chown=1000:1000 /build/web/dist/ ./dist/

USER 1000:1000
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["node", "dist/server/server.js"]
