# Web dev-env mode — points the app at the local hermetic stack (dev-env/).
# Load with: vite --mode devenv  (the e2e Playwright webServer does this).
# All *.test hosts resolve to Caddy (127.0.0.1:443) via the browser's
# --host-resolver-rules; the dev CA is trusted via ignoreHTTPSErrors.
VITE_INDEXER_URL=https://indexer.test
VITE_PLC_DIRECTORY_URL=https://plc.test
VITE_SITE_URL=http://127.0.0.1:5199
VITE_BSKY_APPVIEW_URL=
