FROM rust:1.86-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN cargo build --release --package opake-appview

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1000 opake && useradd -u 1000 -g opake -m opake

COPY --from=builder /build/target/release/opake-appview /usr/local/bin/opake-appview

USER 1000:1000
EXPOSE 6100

ENTRYPOINT ["opake-appview"]
CMD ["run"]
